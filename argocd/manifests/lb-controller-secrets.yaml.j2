# ---------------------------------------------------------------
# LB CNI コントローラ - 機密 Secret
# kubectl apply で直接適用 (ArgoCD 管理外)
# Namespace もここで作成し、argocd_bootstrap が Secret を apply する前に
# Namespace が存在することを保証する
# ---------------------------------------------------------------
---
# ── Namespace ─────────────────────────────────────────────────────
apiVersion: v1
kind: Namespace
metadata:
  name: lb-controller
---
# ── さくらのクラウド API 認証情報 ─────────────────────────────────
apiVersion: v1
kind: Secret
metadata:
  name: lb-controller-sakura
  namespace: lb-controller
type: Opaque
stringData:
  token: "{{ sakura_access_token }}"
  secret: "{{ sakura_access_token_secret }}"
---
# ── コンテナレジストリ Pull 認証 ──────────────────────────────────
apiVersion: v1
kind: Secret
metadata:
  name: lb-controller-registry
  namespace: lb-controller
type: kubernetes.io/dockerconfigjson
stringData:
  .dockerconfigjson: >-
    {"auths":{"{{ container_registry_fqdn }}":{"username":"{{ container_registry_user }}","password":"{{ container_registry_password }}"}}}
